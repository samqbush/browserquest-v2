# BrowserQuest client (Vite) configuration.
# Copy to .env.local and adjust. All vars are optional; defaults shown.

# WebSocket game server host (defaults to localhost in dev, page host in prod build)
# VITE_GAME_HOST=localhost

# WebSocket game server port
# VITE_GAME_PORT=8000

# Whether the client should connect through the dispatcher ("true"/"false")
# VITE_DISPATCHER=false
