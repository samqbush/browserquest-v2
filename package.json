{
  "name": "BrowserQuest",
  "version": "0.0.1",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/js/main.js",
    "dev": "vite",
    "preview": "vite preview",
    "build:client": "vite build",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "madge": "madge --circular client/js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "jquery": "^3.7.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.21.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
