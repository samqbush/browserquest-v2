    "sanitizer": "0.1.3",
    "memcache": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "vitest": "^4.1.9"
  }
}
